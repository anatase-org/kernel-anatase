+                break;
+        case 9:
+                reg = AYN_SENSOR_PWM_FAN_TEMP_5_REG;
+                break;
+        default:
+                return -EINVAL;
+        }
+
+        retval = read_from_ec(reg, 1, &val);
+        if (retval)
+                return retval;
+
+        switch (index) {
+        case 0:
+        case 1:
+        case 2:
+        case 3:
+        case 4:
+                val = val << 1;
+                break;
+        default:
+                break;
