+	[0x05] = BTN_TR, /* Gear UP */
+	[0x06] = BTN_TL, /* Gear DOWN */
+	[0x07] = BTN_TR2, /* R2 */
+	[0x08] = BTN_TL2, /* L2 */
+	[0x09] = BTN_START, /* SH */
+	[0x0a] = BTN_SELECT, /* OP */
+	[0x0b] = BTN_THUMBR, /* R3 */
+	[0x0c] = BTN_THUMBL, /* L3 */
