+			__func__, PTR_ERR(caps));
+		return PTR_ERR(caps);
+	}
+
+	gip_dbg(client, "%s: out=%*phD\n", __func__, caps->count, caps->data);
+	client->capabilities_out = caps;
+
+	caps = gip_parse_info_element(data, len,
+				      pkt->capabilities_in_offset, 1);
+	if (IS_ERR(caps)) {
