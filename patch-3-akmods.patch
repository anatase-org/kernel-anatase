+                break;
+        case 1:
+                reg = AYN_SENSOR_PWM_FAN_SPEED_2_REG;
+                break;
+        case 2:
+                reg = AYN_SENSOR_PWM_FAN_SPEED_3_REG;
+                break;
+        case 3:
+                reg = AYN_SENSOR_PWM_FAN_SPEED_4_REG;
+                break;
+        case 4:
+                reg = AYN_SENSOR_PWM_FAN_SPEED_5_REG;
+                break;
+        case 5:
