+
+	if (open_mode)
+		tsxw_send_open(tsxw);
+
+	return tsxw->open(tsxw->input_dev);
+}
+
+static int tsxw_send_close(struct t300rs_device_entry *tsxw)
+{
+	int r1, r2;
+	tsxw->send_buffer[0] = 0x01;
+	tsxw->send_buffer[1] = 0x05;
