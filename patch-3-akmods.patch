+static void lg4ff_set_leds(struct hid_device *hid, u8 leds)
+{
+	struct lg4ff_device_entry *entry;
+	u8 cmd[7];
+
+	entry = lg4ff_get_device_entry(hid);
+	if (entry == NULL) {
+		return;
+	}
+
+	cmd[0] = 0xf8;
+	cmd[1] = 0x12;
+	cmd[2] = leds;
+	cmd[3] = 0x00;
+	cmd[4] = 0x00;
+	cmd[5] = 0x00;
+	cmd[6] = 0x00;
+	lg4ff_send_cmd(entry, cmd);
+}
