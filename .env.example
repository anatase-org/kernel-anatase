PE_SIGNING_TOKEN="PIV_II (PIV Card Holder pin)"
PE_SIGNING_CERT="Certificate for Digital Signature"
PE_SIGNING_PIN=1

# Google Cloud KMS / libkmsp11 signing.
# First run: gcloud auth application-default login
#
# Set GCP_KMS_KEY to enable Cloud KMS signing. GCP_KMS_KEY may be a CryptoKey
# or CryptoKeyVersion resource name; the build derives the key ring for
# libkmsp11.
# When using KMS, PE_SIGNING_TOKEN is the libkmsp11 token label and
# PE_SIGNING_CERT is the KMS CryptoKey ID/certificate nickname.
#
# Optional standard Google override:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-or-adc.json"
GCP_KMS_KEY=""
GCP_KMS_CERT=""
