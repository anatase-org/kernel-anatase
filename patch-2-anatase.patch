diff --git a/drivers/extcon/Kconfig b/drivers/extcon/Kconfig
index 68d9df7d2dae0d406f15ab87fd32c9cbad7ffbc6..ca1ad4afa38ce9ab6e0c7400d9f5f74a40eec1d2 100644
--- a/drivers/extcon/Kconfig
