 {
@@ -373,6 +461,7 @@ static struct attribute *valve_leds_attrs[] = {
 	&dev_attr_color_shift.attr.attr,
 	&dev_attr_brightness_scale.attr.attr,
 	&dev_attr_brightness_startup.attr,
+	&dev_attr_multi_intensity_startup.attr,
 	NULL,
 };
