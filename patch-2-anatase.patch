From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Antheas Kapenekakis <lkml@antheas.dev>
Date: Mon, 2 Nov 2026 16:03:09 +0100
Subject: drm/i915/quirks: Disable self-refresh and LOBF on ONEXPLAYER 3

Panel Replay freezes the ONEXPLAYER 3 OLED with BT.2020 signalling.
PSR1 also freezes on newer BIOS versions, and leaving LOBF enabled
when self-refresh is disabled makes the panel go black.

Use the existing DMI quirk table with partial vendor and product
matches. Disable PSR and Panel Replay through the existing display
parameters, including the pre-link-training Panel Replay sink enable.
Add a LOBF quirk to the existing quirk mask and check it alongside the
LOBF debug flag.

This trades idle panel power savings for stable display output while
retaining PQ. Hardware validation is still required.

Link: https://gitlab.freedesktop.org/drm/xe/kernel/-/work_items/9692
Link: https://github.com/HHHHanasak1/onexplayer3-steamos-setup/pull/15
Signed-off-by: Antheas Kapenekakis <lkml@antheas.dev>
---
 drivers/gpu/drm/i915/display/intel_alpm.c   |  6 ++++--
 drivers/gpu/drm/i915/display/intel_quirks.c | 20 ++++++++++++++++++++
 drivers/gpu/drm/i915/display/intel_quirks.h |  1 +
 3 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/i915/display/intel_alpm.c b/drivers/gpu/drm/i915/display/intel_alpm.c
index f1383764b7028f8391291842b60eff8b774a24b2..02073630d4b0dbfcb7c53c32fdf8afa0e35d949f 100644
--- a/drivers/gpu/drm/i915/display/intel_alpm.c
+++ b/drivers/gpu/drm/i915/display/intel_alpm.c
@@ -16,6 +16,7 @@
 #include "intel_dp_aux.h"
 #include "intel_psr.h"
 #include "intel_psr_regs.h"
+#include "intel_quirks.h"
 #include "intel_vrr.h"
 
 #define SILENCE_PERIOD_MIN_TIME	80
@@ -328,8 +329,9 @@ void intel_alpm_lobf_compute_config(struct intel_dp *intel_dp,
 {
 	struct intel_display *display = to_intel_display(intel_dp);
 
-	if (intel_dp->alpm.lobf_disable_debug) {
-		drm_dbg_kms(display->drm, "LOBF is disabled by debug flag\n");
+	if (intel_dp->alpm.lobf_disable_debug ||
+	    intel_has_quirk(display, QUIRK_DISABLE_LOBF)) {
+		drm_dbg_kms(display->drm, "LOBF is disabled by debug flag or quirk\n");
 		return;
 	}
 
diff --git a/drivers/gpu/drm/i915/display/intel_quirks.c b/drivers/gpu/drm/i915/display/intel_quirks.c
index 7d7db774d8c7b9e7f09c7d9a3e6fe89645ad6887..3ca0708457ed84b201c48ba869fc3565e76de99e 100644
--- a/drivers/gpu/drm/i915/display/intel_quirks.c
+++ b/drivers/gpu/drm/i915/display/intel_quirks.c
@@ -100,6 +100,14 @@ static void quirk_disable_psr2(struct intel_display *display)
 	drm_info(display->drm, "PSR2 support not currently available for this setup, applying disable PSR2 quirk\n");
 }
 
+static void quirk_disable_psr_and_lobf(struct intel_display *display)
+{
+	display->params.enable_psr = 0;
+	display->params.enable_panel_replay = 0;
+	intel_set_quirk(display, QUIRK_DISABLE_LOBF);
+	drm_info(display->drm, "Disabling PSR, Panel Replay and LOBF\n");
+}
+
 struct intel_quirk {
 	int device;
 	int subsystem_vendor;
@@ -188,6 +196,18 @@ static const struct intel_dmi_quirk intel_dmi_quirks[] = {
 		},
 		.hook = quirk_no_pps_backlight_power_hook,
 	},
+	{
+		.dmi_id_list = &(const struct dmi_system_id[]) {
+			{
+				.matches = {
+					DMI_MATCH(DMI_SYS_VENDOR, "ONE-NETBOOK"),
+					DMI_MATCH(DMI_PRODUCT_NAME, "ONEXPLAYER 3"),
+				},
+			},
+			{ }
+		},
+		.hook = quirk_disable_psr_and_lobf,
+	},
 };
 
 static struct intel_quirk intel_quirks[] = {
diff --git a/drivers/gpu/drm/i915/display/intel_quirks.h b/drivers/gpu/drm/i915/display/intel_quirks.h
index 970a4fe52fafca976259ad823a7bfa218c8581db..b70e7ea42a70e794a391c87b2582e8d862e6a974 100644
--- a/drivers/gpu/drm/i915/display/intel_quirks.h
+++ b/drivers/gpu/drm/i915/display/intel_quirks.h
@@ -23,6 +23,7 @@ enum intel_quirk_id {
 	QUIRK_EDP_LIMIT_RATE_HBR2,
 	QUIRK_DISABLE_EDP_PANEL_REPLAY,
 	QUIRK_DISABLE_PSR2,
+	QUIRK_DISABLE_LOBF,
 };
 
 void intel_init_quirks(struct intel_display *display);
