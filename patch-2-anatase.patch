+		regulator-max-microvolt = <1800000>;
+		gpio = <&pm8550ve_9_gpios 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-0 = <&rtmr0_1p8_en>;
+		pinctrl-names = "default";
