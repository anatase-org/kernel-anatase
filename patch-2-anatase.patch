index 0000000000000000000000000000000000000000..00c7aedb7c11335135bf7c361cfb3a1a674eca2a
--- /dev/null
+++ b/sound/soc/codecs/aw87xxx/aw87xxx_acf_bin.c
@@ -0,0 +1,1558 @@
+/*
