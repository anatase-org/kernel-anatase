+		return -EBUSY;
+
 	dptc->expanded = val;
 	/* Clear staged values: limits changed, old values may be out of range */
 	memset(dptc->staged, 0, sizeof(dptc->staged));
@@ -593,6 +621,75 @@ static void dptc_kset_unregister(void *data)
 	kset_unregister(data);
