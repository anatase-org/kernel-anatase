+static const struct ath12k_msi_config ath12k_ahb_msi_config_wcn7750 = {
+	.total_vectors = 28,
+	.total_users = 2,
+	.users = (struct ath12k_msi_user[]) {
+		{ .name = "CE", .num_vectors = 10, .base_vector = 0 },
+		{ .name = "DP", .num_vectors = 18, .base_vector = 10 },
