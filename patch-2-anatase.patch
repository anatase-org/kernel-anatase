index 7132113957c0..1ce198133bf0 100644
--- a/drivers/platform/x86/Kconfig
+++ b/drivers/platform/x86/Kconfig
@@ -556,6 +556,7 @@ config MSI_WMI_PLATFORM
 	depends on DMI
