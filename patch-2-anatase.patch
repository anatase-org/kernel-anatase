+#define VALVE_NUM_LEDS                   17
+#define VALVE_NUM_COMPONENTS             3
+#define VALVE_BRIGHTNESS_DEFAULT         255
+#define VALVE_BRIGHTNESS_HALF            56 /* Gamma 2.2 */
