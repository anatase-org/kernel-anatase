 		goto out;
 
 	case UI_BEGIN_FF_UPLOAD:
@@ -1098,6 +1107,15 @@ static long uinput_ioctl_handler(struct file *file, unsigned int cmd,
 	case UI_ABS_SETUP & ~IOCSIZE_MASK:
 		retval = uinput_abs_setup(udev, p, size);
