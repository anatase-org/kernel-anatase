 2 files changed, 140 insertions(+)

diff --git a/Documentation/wmi/devices/lenovo-wmi-other.rst b/Documentation/wmi/devices/lenovo-wmi-other.rst
index 011054d64eac5b601333373c4d405f9c5117ffc2..19df4ff0a6da030c87b901d1f858558fa360320a 100644
--- a/Documentation/wmi/devices/lenovo-wmi-other.rst
+++ b/Documentation/wmi/devices/lenovo-wmi-other.rst
@@ -46,6 +46,9 @@ The following HWMON attributes are implemented:
  - fanX_input: current RPM
  - fanX_target: target RPM (tunable, 0=auto)
 
+The following firmware attribute is implemented:
+ - fan_full_speed: Enable full fan speed mode
+
 Due to the internal RPM divisor, the current/target RPMs are rounded down to
 its nearest multiple. The divisor itself is not necessary to be a power of two.
 
diff --git a/drivers/platform/x86/lenovo/wmi-other.c b/drivers/platform/x86/lenovo/wmi-other.c
index fbb32bf404f245ce9e92f540b07408e70b7fb638..4b0288577e10f0424e194c40d401e2605a89cc18 100644
--- a/drivers/platform/x86/lenovo/wmi-other.c
+++ b/drivers/platform/x86/lenovo/wmi-other.c
@@ -83,6 +83,7 @@ enum lwmi_feature_id_psu {
 	LWMI_FEATURE_ID_PSU_CHARGE_BEHAVIOUR =	0x02,
 };
 
+#define LWMI_FEATURE_ID_FAN_FULL_SPEED 0x02
 #define LWMI_FEATURE_ID_FAN_RPM 0x03
 
 #define LWMI_TYPE_ID_CROSSLOAD	0x01
@@ -110,6 +111,10 @@ enum lwmi_feature_id_psu {
 	lwmi_attr_id(LWMI_DEVICE_ID_PSU, feat,		\
 		     LWMI_GZ_THERMAL_MODE_NONE, type)
 
+#define LWMI_ATTR_ID_FAN_FULL_SPEED                                      \
+	lwmi_attr_id(LWMI_DEVICE_ID_FAN, LWMI_FEATURE_ID_FAN_FULL_SPEED, \
+		     LWMI_GZ_THERMAL_MODE_NONE, LWMI_TYPE_ID_NONE)
+
 #define LWMI_OM_SYSFS_NAME "lenovo-wmi-other"
 #define LWMI_OM_HWMON_NAME "lenovo_wmi_other"
 
@@ -144,6 +149,7 @@ struct lwmi_om_priv {
 	int ida_id;
 
 	struct lwmi_fan_info fan_info[LWMI_FAN_NR];
+	bool full_fan_speed_created;
 
