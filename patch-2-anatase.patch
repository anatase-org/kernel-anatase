+#define VALVE_REG_SYNC_FROM_HW(leds, reg, store) do { \
+	int val; \
+	int ret = regmap_read(leds->regmap, reg, &val); \
+	if (ret) { \
+		dev_err(&leds->pdev->dev, "Failed to sync %s from hw: %d\n", __stringify(reg), ret); \
+		return ret; \
+	} \
