diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
index 0e2759ce4822a2b965f2443604963084ee67009c..c6abf5a8b3e9b3f571a5f6b89386bed34a1e5582 100644
