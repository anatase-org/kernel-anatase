index 9edc08b867ca0360483e1456722606ddf9857162..642fa4bc457f66ed55cd379db1a59b9ced3498ea 100644
--- a/arch/x86/kernel/cpu/amd.c
+++ b/arch/x86/kernel/cpu/amd.c
@@ -1052,7 +1052,7 @@ static void init_amd_zen5(struct cpuinfo_x86 *c)
 	if (!x86_match_min_microcode_rev(zen5_rdseed_microcode)) {
 		clear_cpu_cap(c, X86_FEATURE_RDSEED);
 		msr_clear_bit(MSR_AMD64_CPUID_FN_7, 18);
-		pr_emerg_once("RDSEED32 is broken. Disabling the corresponding CPUID bit.\n");
+		pr_err_once("RDSEED32 is broken. Disabling the corresponding CPUID bit.\n");
 	}
 
 	if (cpu_has(c, X86_FEATURE_INVLPGB) &&
-- 
