diff --git a/drivers/gpu/drm/panel/panel-ilitek-il97680a.c b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
new file mode 100644
index 0000000000000000000000000000000000000000..277c1983958493e6551fc5a278e8f2099bf42045
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
@@ -0,0 +1,377 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Ilitek IL97680A panels driver
+ *
+ * Copyright (c) 2026 Teguh Sobirin <teguh@sobir.in>
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_of.h>
+#include <drm/drm_panel.h>
+
+struct panel_info {
+	struct drm_panel panel;
+	struct drm_connector *connector;
+	struct mipi_dsi_device *dsi;
+	const struct panel_desc *desc;
+	enum drm_panel_orientation orientation;
+
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+};
+
+struct panel_desc {
+	unsigned int width_mm;
+	unsigned int height_mm;
+
+	unsigned int bpc;
+	unsigned int lanes;
+	unsigned long mode_flags;
+	enum mipi_dsi_pixel_format format;
+
+	const struct drm_display_mode *modes;
+	unsigned int num_modes;
+	int (*init_sequence)(struct panel_info *pinfo);
+};
+
+static const struct regulator_bulk_data panel_supplies[] = {
+	{ .supply = "vdd" },
+	{ .supply = "vddio" },
+	{ .supply = "vci" },
+	{ .supply = "vdd18" },
+	{ .supply = "vdd28" },
+};
+
+static inline struct panel_info *to_panel_info(struct drm_panel *panel)
+{
+	return container_of(panel, struct panel_info, panel);
+}
+
+static int il97680a_get_current_mode(struct panel_info *pinfo)
+{
+	struct drm_connector *connector = pinfo->connector;
+	struct drm_crtc_state *crtc_state;
+	unsigned int i;
+
+	if (!connector || !connector->state || !connector->state->crtc)
+		return 0;
+
+	crtc_state = connector->state->crtc->state;
+
+	for (i = 0; i < pinfo->desc->num_modes; i++) {
+		if (drm_mode_match(&crtc_state->mode,
+				   &pinfo->desc->modes[i],
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+			return i;
+	}
+
+	return 0;
+}
+
+static int il97680a_rpnova_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+	int cur_mode = il97680a_get_current_mode(pinfo);
+	int cur_vrefresh = drm_mode_vrefresh(&pinfo->desc->modes[cur_mode]);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xc8, 0x62);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x21);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xa4, 0x38);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x23);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x85, 0x15);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
+
+	if (cur_vrefresh == 120)
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x00);
+	else
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x60, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x6d, 0x00);
+
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				     0x0d, 0x75, 0x00, 0x00);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x22);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe1, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
+
+	return dsi_ctx.accum_err;
+}
+
+static const struct drm_display_mode il97680a_rpnova_modes[] = {
+	{
+		/* 120Hz */
+		.clock = (1280 + 12 + 2 + 8) * (960 + 12 + 2 + 24) * 120 / 1000,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 24,
+	},
+	{
+		/* 60Hz */
+		.clock = (1280 + 12 + 2 + 8) * (960 + 12 + 2 + 24) * 60 / 1000,
+		.hdisplay = 1280,
+		.hsync_start = 1280 + 12,
+		.hsync_end = 1280 + 12 + 2,
+		.htotal = 1280 + 12 + 2 + 8,
+		.vdisplay = 960,
+		.vsync_start = 960 + 12,
+		.vsync_end = 960 + 12 + 2,
+		.vtotal = 960 + 12 + 2 + 24,
+	}
+};
+
+static const struct panel_desc il97680a_rpnova_desc = {
+	.modes = il97680a_rpnova_modes,
+	.num_modes = ARRAY_SIZE(il97680a_rpnova_modes),
+	.width_mm = 91,
+	.height_mm = 68,
+	.bpc = 8,
+	.lanes = 4,
+	.format = MIPI_DSI_FMT_RGB888,
+	.mode_flags = MIPI_DSI_MODE_NO_EOT_PACKET |
+		      MIPI_DSI_CLOCK_NON_CONTINUOUS |
+		      MIPI_DSI_MODE_LPM,
+	.init_sequence = il97680a_rpnova_init_sequence,
+};
+
+static void il97680a_reset(struct panel_info *pinfo)
+{
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 0);
+	usleep_range(20000, 21000);
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
+	usleep_range(20000, 21000);
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 0);
+	usleep_range(20000, 21000);
+}
+
+static int il97680a_prepare(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+	if (ret < 0)
+		return ret;
+
+	il97680a_reset(pinfo);
+
+	ret = pinfo->desc->init_sequence(pinfo);
+	if (ret < 0) {
+		gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int il97680a_disable(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int il97680a_unprepare(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+
+	gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
+
+	return 0;
+}
+
+static int il97680a_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+	struct drm_display_mode *mode;
+	unsigned int i;
+
+	for (i = 0; i < pinfo->desc->num_modes; i++) {
+		mode = drm_mode_duplicate(connector->dev, &pinfo->desc->modes[i]);
+		if (!mode)
+			return -ENOMEM;
+
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = pinfo->desc->width_mm;
+	connector->display_info.height_mm = pinfo->desc->height_mm;
+	connector->display_info.bpc = pinfo->desc->bpc;
+	pinfo->connector = connector;
+
+	return pinfo->desc->num_modes;
+}
+
+static enum drm_panel_orientation il97680a_get_orientation(struct drm_panel *panel)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+
+	return pinfo->orientation;
+}
+
+static const struct drm_panel_funcs il97680a_panel_funcs = {
+	.disable = il97680a_disable,
+	.prepare = il97680a_prepare,
+	.unprepare = il97680a_unprepare,
+	.get_modes = il97680a_get_modes,
+	.get_orientation = il97680a_get_orientation,
+};
+
+static int il97680a_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return ret;
+}
+
+static int il97680a_bl_get_brightness(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness;
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+	if (ret < 0)
+		return ret;
+
+	return brightness;
+}
+
+static const struct backlight_ops il97680a_bl_ops = {
+	.update_status = il97680a_bl_update_status,
+	.get_brightness = il97680a_bl_get_brightness,
+};
+
+static struct backlight_device *
+il97680a_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 3445,
+		.max_brightness = 3445,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &il97680a_bl_ops, &props);
+}
+
+static int il97680a_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct panel_info *pinfo;
+	int ret;
+
+	pinfo = devm_drm_panel_alloc(dev, struct panel_info, panel,
+				     &il97680a_panel_funcs,
+				     DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(pinfo))
+		return PTR_ERR(pinfo);
+
+	pinfo->desc = of_device_get_match_data(dev);
+	if (!pinfo->desc)
+		return -ENODEV;
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(panel_supplies),
+					    panel_supplies, &pinfo->supplies);
+	if (ret < 0)
+		return ret;
+
+	pinfo->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(pinfo->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(pinfo->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	pinfo->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, pinfo);
+
+	ret = drm_of_get_panel_orientation(dev->of_node, &pinfo->orientation);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get orientation\n");
+
+	dsi->lanes = pinfo->desc->lanes;
+	dsi->format = pinfo->desc->format;
+	dsi->mode_flags = pinfo->desc->mode_flags;
+	pinfo->panel.prepare_prev_first = true;
+
+	pinfo->panel.backlight = il97680a_create_backlight(dsi);
+	if (IS_ERR(pinfo->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(pinfo->panel.backlight),
+				     "Failed to create backlight\n");
+
+	ret = devm_drm_panel_add(dev, &pinfo->panel);
+	if (ret)
+		return ret;
+
+	return devm_mipi_dsi_attach(dev, dsi);
+}
+
+static const struct of_device_id il97680a_of_match[] = {
+	{ .compatible = "retroidpocket,rpnova-panel", .data = &il97680a_rpnova_desc },
+	{ .compatible = "retroidpocket,rpduo-panel-bottom", .data = &il97680a_rpnova_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, il97680a_of_match);
+
+static struct mipi_dsi_driver il97680a_driver = {
+	.probe = il97680a_probe,
+	.driver = {
+		.name = "panel-ilitek-il97680a",
+		.of_match_table = il97680a_of_match,
+	},
+};
+module_mipi_dsi_driver(il97680a_driver);
+
+MODULE_AUTHOR("Teguh Sobirin <teguh@sobir.in>");
+MODULE_DESCRIPTION("DRM driver for Ilitek IL97680A based MIPI DSI panels");
+MODULE_LICENSE("GPL");
-- 
2.56.0


From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Mon, 19 Oct 2026 19:33:47 +0700
Subject: dt-bindings: input: add RSInput UART gamepad controller

Document the gamepad microcontroller used in AYN and Retroid Pocket
handhelds. It is attached to a UART and reports the buttons, the two
analog sticks and the two triggers.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 .../bindings/input/ayntec,rsinput.yaml        | 128 ++++++++++++++++++
 1 file changed, 128 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/ayntec,rsinput.yaml

diff --git a/Documentation/devicetree/bindings/input/ayntec,rsinput.yaml b/Documentation/devicetree/bindings/input/ayntec,rsinput.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..876c8d26d1b51f2a93c037505a12ba9b4317c857
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/ayntec,rsinput.yaml
@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/ayntec,rsinput.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: RSInput UART gamepad controller
+
+maintainers:
+  - Teguh Sobirin <teguh@sobir.in>
+
+description:
+  Gamepad microcontroller found in AYN and Retroid Pocket handhelds. It is
+  attached to a UART running at 115200 baud and reports the buttons, the two
+  analog sticks and the two triggers in periodic status frames.
+
+allOf:
+  - $ref: /schemas/serial/serial-peripheral-props.yaml#
+
+properties:
+  compatible:
+    enum:
+      - ayntec,rsinput
+      - retroidpocket,rsinput
+
+  vdd-supply:
+    description: MCU power supply.
+
+  enable-gpios:
+    maxItems: 1
+    description: GPIO enabling the MCU.
+
+  reset-gpios:
+    maxItems: 1
+    description: GPIO connected to the MCU reset line.
+
+  boot-gpios:
+    maxItems: 1
+    description: GPIO selecting the MCU boot mode, driven low for normal boot.
+
+  gamepad-name:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: Name of the input device.
+
+  gamepad-bus:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Bus type reported in the input device ID.
+
+  gamepad-vid:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Vendor ID reported in the input device ID.
+
+  gamepad-pid:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Product ID reported in the input device ID.
+
+  gamepad-rev:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Version reported in the input device ID.
+
+  invert-x:
+    type: boolean
+    description: Invert the left stick X axis.
+
+  invert-y:
+    type: boolean
+    description: Invert the left stick Y axis.
+
+  invert-rx:
+    type: boolean
+    description: Invert the right stick X axis.
+
+  invert-ry:
+    type: boolean
+    description: Invert the right stick Y axis.
+
+  axis-range:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    default: 0x580
+    description:
+      Stick travel in raw units. Every stick axis is reported in the range
+      -axis-range to +axis-range.
+
+  trigger-left-deadzone:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    default: 0
+    description: Raw left trigger travel reported as released.
+
+  trigger-right-deadzone:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    default: 0
+    description: Raw right trigger travel reported as released.
+
+  digital-triggers:
+    type: boolean
+    description:
+      The triggers are switches. Report them as buttons instead of axes.
+
+required:
+  - compatible
+  - vdd-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    serial {
+        gamepad {
+            compatible = "ayntec,rsinput";
+
+            gamepad-name = "AYN Odin2 Gamepad";
+            gamepad-bus = <0x0003>;
+            gamepad-vid = <0x2020>;
+            gamepad-pid = <0x3001>;
+            gamepad-rev = <0x0001>;
+
+            vdd-supply = <&vdd_mcu_3v3>;
+            enable-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
+
+            axis-range = <1024>;
+            invert-x;
+            invert-y;
+            trigger-left-deadzone = <100>;
+            trigger-right-deadzone = <100>;
+        };
+    };
-- 
